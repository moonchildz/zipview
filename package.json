{
  "name": "apartment-view-poc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/build-linkage.mjs",
    "prebuild": "node scripts/build-linkage.mjs",
    "build:linkage": "node scripts/build-linkage.mjs",
    "collect:addresses": "node scripts/address-pipeline.mjs",
    "pipeline:addresses": "node scripts/run-address-pipeline.mjs",
    "query:linkage": "node scripts/query-linkage.mjs",
    "verify:addresses": "node scripts/verify-address-coverage.mjs",
    "verify:units": "node scripts/audit-unit-linkage.mjs",
    "verify:targets": "node scripts/audit-target-flow.mjs",
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "test": "node --test tests/*.test.mjs",
    "probe:maps": "node scripts/probe-maps.mjs",
    "verify:browser": "node tests/browser.mjs",
    "collect:seoul": "node scripts/collect-seoul.mjs",
    "collect:seoul-terrain": "node scripts/collect-seoul-terrain.mjs",
    "build:seoul": "node --max-old-space-size=8192 scripts/build-seoul.mjs",
    "query:seoul": "node scripts/query-seoul.mjs",
    "verify:seoul": "node scripts/verify-seoul.mjs",
    "register:plan": "node scripts/register-plan.mjs",
    "extract:charts": "node scripts/extract-image-charts.mjs && node scripts/build-linkage.mjs"
  },
  "dependencies": {
    "lucide": "^0.468.0",
    "osmtogeojson": "3.0.0-beta.5",
    "three": "^0.180.0"
  },
  "overrides": {
    "osmtogeojson": {
      "@xmldom/xmldom": "0.9.12"
    }
  },
  "devDependencies": {
    "cheerio": "^1.2.0",
    "csv-parse": "^7.0.2",
    "playwright": "^1.55.0",
    "pngjs": "^7.0.0",
    "sharp": "^0.35.4",
    "vite": "^7.0.0",
    "yauzl": "^3.4.0"
  }
}
